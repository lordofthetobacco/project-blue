+namespace blue::render {
+
+std::unique_ptr<RendererBackend> CreateMetalRenderer(
+    const RendererOptions& options) {
+  if (options.window == nullptr) {
+    // The headless output image is not implemented for Metal yet (package
+    // M1); the backend factory falls back to another backend.
+    core::log::Warn("Metal: headless rendering is not implemented yet");
+    return nullptr;
+  }
+  // What MetalContext requires; checked here so that a Mac without Metal 4
+  // falls back instead of failing.
+  id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+  if (device == nil || ![device supportsFamily:MTLGPUFamilyMetal4]) {
+    return nullptr;
+  }
+  // The Metal shaders live in shaders/metal, next to the other backends'.
+  return std::make_unique<metal::MetalRenderer>(
+      *options.window, core::JoinPath(options.shader_dir, "metal"),
+      options.shader_mode);
+}
