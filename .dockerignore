# Build context for server/Dockerfile is the repository root. Allow-list:
# exclude everything, then re-include only what the image build reads.
*
!CMakeLists.txt
!CMakePresets.json
!cmake/
!src/
!server/

# Never send build output or local state.
server/target/
server/**/target/
**/*.swp
**/.DS_Store
**/.vs/
**/.vscode/
**/.idea/
