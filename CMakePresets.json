{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "backend-default",
            "hidden": true,
            "description": "Hook for the renderer backend options (BLUE_RENDERER_VULKAN, BLUE_RENDERER_D3D12, BLUE_RENDERER_METAL): every platform preset inherits this, so backend cache variables are set in one place.",
            "cacheVariables": {}
        },
        {
            "name": "base",
            "hidden": true,
            "inherits": "backend-default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}"
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-clang-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl.exe",
                "CMAKE_CXX_COMPILER": "clang-cl.exe"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-gcc-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-arm64-base",
            "hidden": true,
            "inherits": "macos-base",
            "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
        },
        {
            "name": "macos-x64-base",
            "hidden": true,
            "inherits": "macos-base",
            "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" }
        },

        {
            "name": "x64-debug",
            "displayName": "x64 Debug (MSVC)",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release (MSVC)",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "x64-relwithdebinfo",
            "displayName": "x64 RelWithDebInfo (MSVC)",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "x64-clang-debug",
            "displayName": "x64 Debug (clang-cl)",
            "inherits": "windows-clang-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "x64-clang-release",
            "displayName": "x64 Release (clang-cl)",
            "inherits": "windows-clang-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux Debug (GCC)",
            "inherits": "linux-gcc-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux Release (GCC)",
            "inherits": "linux-gcc-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Debug (Clang)",
            "inherits": "linux-clang-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-clang-release",
            "displayName": "Linux Release (Clang)",
            "inherits": "linux-clang-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "macos-arm64-debug",
            "displayName": "macOS Apple Silicon Debug",
            "inherits": "macos-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "macos-arm64-release",
            "displayName": "macOS Apple Silicon Release",
            "inherits": "macos-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "macos-x64-debug",
            "displayName": "macOS Intel Debug",
            "inherits": "macos-x64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "macos-x64-release",
            "displayName": "macOS Intel Release",
            "inherits": "macos-x64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "x64-debug", "configurePreset": "x64-debug" },
        { "name": "x64-release", "configurePreset": "x64-release" },
        { "name": "x64-relwithdebinfo", "configurePreset": "x64-relwithdebinfo" },
        { "name": "x64-clang-debug", "configurePreset": "x64-clang-debug" },
        { "name": "x64-clang-release", "configurePreset": "x64-clang-release" },
        { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
        { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
        { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
        { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
        { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug" },
        { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
        { "name": "macos-x64-debug", "configurePreset": "macos-x64-debug" },
        { "name": "macos-x64-release", "configurePreset": "macos-x64-release" }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        { "name": "x64-debug", "inherits": "test-base", "configurePreset": "x64-debug" },
        { "name": "x64-release", "inherits": "test-base", "configurePreset": "x64-release" },
        { "name": "x64-relwithdebinfo", "inherits": "test-base", "configurePreset": "x64-relwithdebinfo" },
        { "name": "x64-clang-debug", "inherits": "test-base", "configurePreset": "x64-clang-debug" },
        { "name": "x64-clang-release", "inherits": "test-base", "configurePreset": "x64-clang-release" },
        { "name": "linux-gcc-debug", "inherits": "test-base", "configurePreset": "linux-gcc-debug" },
        { "name": "linux-gcc-release", "inherits": "test-base", "configurePreset": "linux-gcc-release" },
        { "name": "linux-clang-debug", "inherits": "test-base", "configurePreset": "linux-clang-debug" },
        { "name": "linux-clang-release", "inherits": "test-base", "configurePreset": "linux-clang-release" },
        { "name": "macos-arm64-debug", "inherits": "test-base", "configurePreset": "macos-arm64-debug" },
        { "name": "macos-arm64-release", "inherits": "test-base", "configurePreset": "macos-arm64-release" },
        { "name": "macos-x64-debug", "inherits": "test-base", "configurePreset": "macos-x64-debug" },
        { "name": "macos-x64-release", "inherits": "test-base", "configurePreset": "macos-x64-release" }
    ]
}
